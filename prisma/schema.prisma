generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  resetToken          String?
  resetTokenExpiry    DateTime?
  // Sales Analyser integration credentials (account-level).
  // Used to authenticate machine-to-machine calls to the Sales Analyser app
  // so call recordings can be sent for analysis. Stored to allow background
  // (post-call) analysis when no interactive session is available.
  salesAnalyserEmail    String?
  salesAnalyserPassword String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agents              VoiceAgent[]
  telephonyProviders  TelephonyProvider[]
  campaigns           Campaign[]
  callHistory         CallHistory[]

  @@map("users")
}

model VoiceAgent {
  id                   String   @id @default(cuid())
  name                 String
  systemPrompt         String   @db.Text
  voiceName            String   @default("Puck")
  modelName            String   @default("gemini-2.5-flash-native-audio-latest")
  publicPreviewEnabled Boolean  @default(false)
  vadStartSensitivity  String   @default("START_SENSITIVITY_HIGH")
  vadEndSensitivity    String   @default("END_SENSITIVITY_HIGH")
  vadPrefixPaddingMs   Int      @default(100)
  vadSilenceDurationMs Int      @default(300)
  firstMessage         String?
  languageCode         String   @default("en-US")
  inactivityTimeoutMs  Int      @default(10000)
  maxInactivityNudges  Int      @default(3)
  maxCallDurationSecs  Int      @default(0)
  // Sales Analyser integration (per agent).
  // When enabled, completed call recordings for this agent are sent to the
  // Sales Analyser app using the named analysis template.
  callAnalysisEnabled  Boolean  @default(false)
  analysisTemplateName String?
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns            Campaign[]
  callHistory          CallHistory[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("voice_agents")
}

model TelephonyProvider {
  id            String   @id @default(cuid())
  name          String
  provider      String   @default("vobiz")
  direction     String   @default("outbound")
  isActive      Boolean  @default(true)
  phoneNumber   String?
  sipServer     String?
  sipUsername    String?
  sipPassword   String?
  apiKey        String?
  apiSecret     String?
  accountSid    String?
  authToken     String?
  webhookUrl    String?
  extraConfig   String?  @db.Text
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns     Campaign[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("telephony_providers")
}

model Campaign {
  id              String             @id @default(cuid())
  name            String
  status          String             @default("draft")
  agentId         String
  agent           VoiceAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  providerId      String?
  provider        TelephonyProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  variableColumns Json               @default("[]")
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        CampaignContact[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("campaigns")
}

model CampaignContact {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phoneNumber  String
  variables    Json     @default("{}")
  status       String   @default("pending")
  callId       String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("campaign_contacts")
}

model CallHistory {
  id                String      @id @default(cuid())
  sessionId         String      @unique
  callType          String      @default("test")
  status            String      @default("in_progress")
  direction         String?
  phoneNumber       String?
  agentName         String
  durationSecs      Int         @default(0)
  recordingKey      String?
  recordingMimeType String?
  transcript        Json        @default("[]")
  startedAt         DateTime    @default(now())
  endedAt           DateTime?
  agentId           String?
  agent             VoiceAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([agentId])
  @@map("call_history")
}
