# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/voice_agents?schema=public"
#
# On a managed/serverless Postgres (Neon, Supabase, RDS Proxy), use the provider's
# POOLED endpoint and cap the client pool explicitly. Prisma otherwise sizes its
# pool from the host CPU count, which can exceed what a small database allows:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require&connection_limit=5&pool_timeout=20"

# Server port
PORT=3000

# Background campaign scheduler.
#
# The scheduler only runs while campaigns are scheduled or running: it wakes when
# a campaign is queued and goes dormant once there is nothing left to dial, so an
# idle deployment issues no queries and a scale-to-zero database can suspend.
# Set to false to switch it off entirely (useful locally, and for any instance
# that should never place calls). Scheduled campaigns will not run when disabled.
# CAMPAIGN_SCHEDULER_ENABLED=false

# Public base URL used by the background campaign scheduler to build the Vobiz
# answer_url for scheduled/windowed outbound calls. Must be reachable by Vobiz.
# Falls back to http://localhost:${PORT} when unset.
PUBLIC_BASE_URL=http://localhost:3000

# External landing page URL (the standalone Next.js landing site)
# All landing page requests (/, /landing, /landing.html) redirect here
LANDING_PAGE_URL=http://localhost:3001

# Website branding and theme
WEBSITE_NAME=AnshulTheGreat.com
WEBSITE_THEME=dark
# WEBSITE_THEME=light
# WEBSITE_THEME=dark

# Optional backward-compatible alias for website theme
# THEME=light
# THEME=dark

# Logging
LOG_LEVEL=info
LOG_DIR=logs
    LOG_TO_CONSOLE=true

# Cloudflare R2 object store (call recordings)
# Create an R2 bucket + API token at https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=voice-call-recordings
# Optional: override the S3 API endpoint (defaults to https://<account_id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Optional: public base URL if the bucket is served via a public domain
# R2_PUBLIC_URL=https://recordings.example.com

# Sales Analyser integration
# Base URL of the Sales Analyser app that exposes POST /api/external/analyze.
# When set, completed call recordings for agents with analysis enabled are sent
# there for analysis using the agent's configured template name.
# Leave unset to disable the integration entirely.
SALES_ANALYSER_URL=http://localhost:3002
