# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/voice_agents?schema=public"

# Server port
PORT=3000

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_CONSOLE=true
