# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/voice_agents?schema=public"

# Server port
PORT=3000

# External landing page URL (the standalone Next.js landing site)
# All landing page requests (/, /landing, /landing.html) redirect here
LANDING_PAGE_URL=http://localhost:3001

# Website branding and theme
WEBSITE_NAME=AnshulTheGreat.com
WEBSITE_THEME=dark
# WEBSITE_THEME=light
# WEBSITE_THEME=dark

# Optional backward-compatible alias for website theme
# THEME=light
# THEME=dark

# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_CONSOLE=true

# Asterisk ARI (SIP bridge)
ARI_URL=http://your-asterisk-host:8088
ARI_USERNAME=voice_app
ARI_PASSWORD=your_ari_secret
APP_CALLBACK_URL=https://your-public-app-url
# Optional overrides
# ARI_APP_NAME=voice_app
# ARI_RTP_HOST=your-public-ip
# ARI_DEFAULT_AGENT_ID=your-agent-id
# ARI_RTP_PORT_MIN=40000
# ARI_RTP_PORT_MAX=45000
